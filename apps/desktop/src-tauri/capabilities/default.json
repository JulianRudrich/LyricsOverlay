{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the overlay, settings, lyrics editor and True Shuffle windows may do.",
  "windows": ["overlay", "settings", "editor", "shuffle"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/JulianRudrich/LyricsOverlay" },
        { "url": "https://github.com/JulianRudrich/LyricsOverlay/*" },
        { "url": "https://lrclib.net/*" }
      ]
    }
  ]
}
