{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the overlay, settings, welcome, lyrics editor, True Shuffle and karaoke windows may do.",
  "windows": ["overlay", "settings", "welcome", "editor", "shuffle", "karaoke"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/JulianRudrich/Singline" },
        { "url": "https://github.com/JulianRudrich/Singline/*" },
        { "url": "https://lrclib.net/*" }
      ]
    }
  ]
}
