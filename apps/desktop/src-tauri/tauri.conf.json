{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyrics Overlay",
  "mainBinaryName": "lyrics-overlay",
  "version": "0.3.0",
  "identifier": "io.github.julianrudrich.lyricsoverlay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Synced lyrics above your other windows",
    "longDescription": "Lyrics Overlay shows synced lyrics for Spotify, Apple Music and Amazon Music in a small window above your other apps.",
    "copyright": "Copyright © 2026 Julian Rudrich",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
